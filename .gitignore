# Operating System Files
.DS_Store
Thumbs.db

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.hypothesis/

# Node / Frontend
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.next/
out/
.turbo/

# Smart Contracts / Foundry
contracts/cache/
contracts/out/
contracts/broadcast/
broadcast/
# Foundry dependencies (forge-std submodule) must stay tracked despite the Python `lib/` rule above
!contracts/lib/
# Frontend source (src/lib) is code, not a build folder; keep it tracked despite the `lib/` rule
!frontend/src/lib/
cache/

# Data & Runtime Files
# Runtime data is ignored, except committed fixtures and .gitkeep placeholders.
# Git cannot re-include a file inside an excluded folder, so folders are re-included first.
data/**
!data/**/
!data/fixtures/**
!data/**/.gitkeep
*.sqlite
*.sqlite3
*.log

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
