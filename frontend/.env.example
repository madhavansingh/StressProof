# ==========================================
# StressProof Frontend Environment Variables
# ==========================================

# --- Browser-Visible Client Variables ---
# Public backend API URL (Render deployed backend)
NEXT_PUBLIC_BACKEND_URL=https://stressproof-hvf3.onrender.com
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8546
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_WC_PROJECT_ID=   # Reown (WalletConnect) project ID from https://dashboard.reown.com; WalletConnect wallets incl. Cake Wallet stay hidden while empty

# --- Server-Side Only Private Secrets (NEVER add NEXT_PUBLIC_ prefix) ---
# Used exclusively by Next.js Route Handlers (e.g. /api/stress/run)
API_WRITE_TOKEN=            # set only in the server environment (e.g. Vercel project settings); never commit a real value
# Internal or public backend network URL for server fetch calls
BACKEND_INTERNAL_URL=https://stressproof-hvf3.onrender.com
