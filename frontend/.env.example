# ==========================================
# StressProof Frontend Environment Variables
# ==========================================

# --- Browser-Visible Client Variables ---
# Public backend API URL (accessible from user's browser for GET requests)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_WC_PROJECT_ID=demo_project_id

# --- Server-Side Only Private Secrets (NEVER add NEXT_PUBLIC_ prefix) ---
# Used exclusively by Next.js Route Handlers (e.g. /api/stress/run)
API_WRITE_TOKEN=stressproof_dev_token_secret
# Optional: Internal backend network URL (e.g., http://backend:8000 in Docker or VPC)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
