# ==========================================
# StressProof Environment Configuration Template
# Copy to .env and populate keys and RPCs
# DO NOT COMMIT .env
# ==========================================

# --- Chains & RPCs ---
MAINNET_ARCHIVE_RPC_URL=            # Ethereum mainnet archive RPC (read-only for snapshot extraction)
FORK_RPC_URL=http://127.0.0.1:8545  # Local Anvil fork of mainnet at FORK_BLOCK
FORK_BLOCK=                         # Pinned mainnet block number
TESTNET_RPC_URL=                    # Base Sepolia RPC URL
TESTNET_CHAIN_ID=84532              # Base Sepolia Chain ID
LOCAL_RPC_URL=http://127.0.0.1:8546 # Local Anvil (standalone, non-fork) for E2E tests
DEPLOYMENTS_FILE=deployments/84532.json

# --- Wallets & Private Keys (5 roles, 1 key per role) ---
DEPLOYER_PK=                        # Deployer of contracts and DemoVault owner
ATTESTER_PK=                        # Honest attester agent (funded >= 10x BOND + gas)
MALICIOUS_PK=                       # Scripted malicious attester (demo only)
WATCHER_PK=                         # Watcher agent / challenger (funded >= 10x BOND + gas)
RESOLVER_PK=                        # Designated resolver wallet (gas only; NEVER posts/challenges)
# Optional: role addresses for machines that do not hold every key (Deploy reads <ROLE>_ADDRESS before <ROLE>_PK)
ATTESTER_ADDRESS=
MALICIOUS_ADDRESS=
WATCHER_ADDRESS=
RESOLVER_ADDRESS=
GIT_COMMIT=                         # Set by `make deploy-*` (git rev-parse HEAD); only needed for manual forge script runs

# --- Contract Constants (Deploy-time) ---
BOND_WEI=10000000000000000           # 0.01 ETH in wei
CHALLENGE_WINDOW_SEC=120            # 2 minutes for demo
RESOLUTION_WINDOW_SEC=300           # 5 minutes for demo
TOLERANCE_BPS=0                     # Exact integer match required
MARKET_ID_STRING=aave-v3-eth-weth-stable
PAUSE_THRESHOLD_USD8=               # Set from sweep (2 * R). Local fixture R: 400000000002
LTV_THRESHOLD_USD8=                 # Set from sweep (R / 2). Local fixture R: 100000000000
REDUCED_LTV_BPS=5000                # Reduced LTV on trigger (50%)
DEFAULT_MAX_LTV_BPS=8000            # Default maximum LTV (80%)

# --- Backend & Storage ---
BACKEND_URL=http://127.0.0.1:8000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
API_WRITE_TOKEN=stressproof_dev_token_secret  # public local-dev placeholder; the backend refuses it when DATABASE_URL is set
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000
IPFS_PINNING_ENABLED=false
IPFS_PIN_API_URL=
IPFS_PIN_JWT=
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# --- Fetch Limits & Security ---
FETCH_MAX_BYTES=26214400            # 25 MB max case file size
FETCH_TIMEOUT_SEC=10                # 10s timeout
FETCH_RETRIES=3
FETCH_ALLOW_LOCALHOST=true          # true in dev, false on public demo machines

# --- Agents Configuration ---
WATCHER_POLL_SEC=2                  # Poll interval
WATCHER_START_BLOCK=0               # Deployment block of registry
FIXED_SCENARIO_ASSET=WETH
FIXED_SCENARIO_SHOCK_BPS=-3000      # -30% shock
DATASET_ID=weth-stable-fixture-v1   # committed fixture dataset (data/fixtures/datasets/); replace after extraction

# --- Phase 2: Graph & LLM (Optional) ---
TG_HOST=
TG_GRAPH=StressProof
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_API_KEY=

# --- Frontend (Client-side exposed NEXT_PUBLIC_*) ---
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_WC_PROJECT_ID=   # Reown (WalletConnect) project ID from https://dashboard.reown.com; WalletConnect wallets incl. Cake Wallet stay hidden while empty
